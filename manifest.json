{
  "manifest_version": 3,
  "name": "Docent Tools voor Magister",
  "version": "0.68.2",
  "description": "Extra functies voor docenten in Magister: thema’s, zijkolom, tabellen naar Excel, sneller invoeren en aanwezigheidsoverzichten.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "sidePanel"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "*://*.magister.net/*"
  ],
  "action": {
    "default_title": "Docent Tools voor Magister",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.magister.net/*"
      ],
      "js": [
        "lib/xlsx.full.min.js",
        "content/defaults.js",
        "content/core.js",
        "content/modules/theme-kleur.js",
        "content/modules/theme-pagina.js",
        "content/modules/theme-apple.js",
        "content/modules/theme-magisterkleuren.js",
        "content/modules/theme-themas.js",
        "content/modules/theme.js",
        "content/modules/compact.js",
        "content/modules/panel.js",
        "content/modules/tables.js",
        "content/modules/quickinput.js",
        "content/modules/navigation.js",
        "content/modules/aanwezigheid.js",
        "content/modules/ai.js",
        "content/modules/inspector.js",
        "content/modules/jarig.js",
        "content/modules/leerlingdash.js",
        "content/modules/verzuiminzicht.js",
        "content/modules/periodes.js",
        "content/modules/aanwezigexport.js",
        "content/modules/xlsx-visueel.js",
        "content/modules/lesopslag.js",
        "content/modules/lesreg.js",
        "content/modules/leaderboard.js",
        "content/modules/opleidingen-reken.js",
        "content/modules/opleidingen.js",
        "content/modules/opleidingen-gegevens.js",
        "content/modules/hoofdmenu.js",
        "content/modules/lestools.js",
        "content/kolom.js",
        "content/boot.js"
      ],
      "css": [
        "content/base.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.magister.net/*"
      ],
      "js": [
        "content/shadowroots.js",
        "content/netlog.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Zijkolom openen/sluiten"
    },
    "toggle-theme": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Donker/licht thema wisselen"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
